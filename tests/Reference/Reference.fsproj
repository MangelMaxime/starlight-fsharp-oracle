<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Global.fs" />
    <Compile Include="Shapes.fs" />
    <Compile Include="Geometry.fs" />
    <Compile Include="Text.fs" />
    <Compile Include="Objects.fs" />
    <Compile Include="Generics.fs" />
    <Compile Include="Reactive.fs" />
    <Compile Include="ActivePatterns.fs" />
    <Compile Include="MissingSyntaxes.fs" />
    <Compile Include="Coverage.fs" />
  </ItemGroup>

  <!--
    ActivePatterns.fsi is deliberately NOT compiled. It is telplin+fantomas output kept
    as a formatting reference for how F# renders signatures. See V1-PLAN.md.
  -->
  <ItemGroup>
    <None Include="ActivePatterns.fsi" />
  </ItemGroup>

</Project>
